# Tifa Lockhart Bot — V1 environment template
# Copy this file to .env for local development.
# Never commit .env or place real credentials in this template.

# Application
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
PORT=10000

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
OWNER_DISCORD_ID=
DISCORD_DISCOVERIES_CHANNEL_ID=
DISCORD_SAVES_CHANNEL_ID=

# Optional category routing; empty JSON uses the discoveries channel
DISCORD_CATEGORY_CHANNELS_JSON={}

# Reddit / PRAW
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Keep false until the intended Reddit access is authorized.
REDDIT_ACCESS_APPROVED=false
REDDIT_ENABLED=true
REDDIT_MAX_ITEMS_PER_RUN=100

# Brave Search HTML discovery
# Keep disabled until the specific automated HTML access method is confirmed permissible.
BRAVE_HTML_ENABLED=false
BRAVE_SEARCH_BASE_URL=https://search.brave.com/search
BRAVE_SEARCH_INTERVAL_HOURS=8

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (private bucket)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto

# Limits
MAX_MEDIA_BYTES=10000000
MAX_PAGE_BYTES=5000000
MAX_CRAWL_DEPTH=6
MAX_URLS_PER_JOB=300
MAX_PAGES_PER_DOMAIN=20
MAX_CONCURRENT_REQUESTS=5
PER_DOMAIN_DELAY_SECONDS=2
MAX_REDIRECTS=5
