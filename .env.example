# Tifa Lockhart Bot - V1 environment template.
# Copy this file to .env and fill in values for your own environment.
# Never commit .env or real credentials.

# Application
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
PORT=10000

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
OWNER_DISCORD_ID=
DISCORD_DISCOVERIES_CHANNEL_ID=
DISCORD_SAVES_CHANNEL_ID=

# Optional category routing; leave empty or {} to use the discoveries channel.
DISCORD_CATEGORY_CHANNELS_JSON={}

# Reddit / PRAW (Phase 4 collection and /save)
# REDDIT_ACCESS_APPROVED must remain false until authorized API access is approved.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_ACCESS_APPROVED=false
REDDIT_ENABLED=true
REDDIT_SEED_DISCOVERY_ENABLED=true
REDDIT_MAX_ITEMS_PER_RUN=100
REDDIT_SEARCH_PHRASES=Tifa Lockhart|Tifa Lockhart fanart|Tifa cosplay|Tifa Lockhart cosplay|Tifa Lockhart NSFW

# Brave HTML discovery (Phase 5)
# Both BRAVE_HTML_ENABLED and BRAVE_HTML_ACCESS_APPROVED must be true before
# the adapter makes any live request. Approval is an explicit operator
# acknowledgement, never enabled automatically by the application.
BRAVE_HTML_ENABLED=false
BRAVE_HTML_ACCESS_APPROVED=false
BRAVE_SEARCH_BASE_URL=https://search.brave.com/search
BRAVE_SEARCH_INTERVAL_HOURS=8
BRAVE_SEARCH_PHRASES=Tifa Lockhart|Tifa Lockhart fanart|Tifa cosplay|Tifa Lockhart cosplay|Tifa Lockhart NSFW
BRAVE_SEARCH_MAX_PAGES_PER_PHRASE=2

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Backblaze B2 (private bucket, S3-compatible API)
# The endpoint and region must match the bucket's actual B2 region.
# Example: B2_REGION=us-west-004
#          B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT_URL=
B2_REGION=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional still-image perceptual similarity signal (never used for deduplication)
PERCEPTUAL_HASH_ENABLED=false

# V1 operating limits
MAX_MEDIA_BYTES=10000000
MAX_PAGE_BYTES=5000000
MAX_CRAWL_DEPTH=6
MAX_URLS_PER_JOB=300
MAX_PAGES_PER_DOMAIN=20
MAX_CONCURRENT_REQUESTS=5
PER_DOMAIN_DELAY_SECONDS=2
MAX_REDIRECTS=5
CRAWL_CONNECT_TIMEOUT_SECONDS=10
CRAWL_READ_TIMEOUT_SECONDS=20
CRAWL_MAX_ATTEMPTS=3
CRAWL_BATCH_SIZE=25
